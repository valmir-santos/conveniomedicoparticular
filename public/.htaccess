# Redirecionamentos 301 e 410 do site antigo (WordPress) para a nova arquitetura
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Artigos legados de benefícios redirecionados diretamente (301) para o artigo equivalente no blog
  RewriteRule ^os-beneficios-de-um-convenio-medico-particular/?$ /blog/abrir-mei-so-para-plano-de-saude-risco [R=301,L]
  RewriteRule ^explorando-os-beneficios-do-convenio-medico-particular/?$ /blog/abrir-mei-so-para-plano-de-saude-risco [R=301,L]

  # 2. Categoria legada de blog apontando para a nova listagem do blog (301)
  RewriteRule ^category/blog/?$ /blog [R=301,L]

  # 3. Página de teste do WordPress marcada como excluída definitivamente (410 Gone)
  RewriteRule ^pagina-exemplo/?$ - [G,L]

  # SPA Fallback para React Router
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
