{
  "redirects": [
    {
      "source": "/pagina-exemplo{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/blog{/}?",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/category/:slug*{/}?",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/author/:slug*{/}?",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/explorando-os-beneficios-do-convenio-medico-particular{/}?",
      "destination": "/convenio-medico-individual-familiar",
      "permanent": true
    },
    {
      "source": "/os-beneficios-de-um-convenio-medico-particular{/}?",
      "destination": "/plano-de-saude-sem-cnpj",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
