{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:slug*{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed{/}?",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/:path*/feed{/}?",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/pagina-exemplo{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/blog{/}?",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/category/:slug*{/}?",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/author/:slug*{/}?",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/explorando-os-beneficios-do-convenio-medico-particular{/}?",
      "destination": "/convenio-medico-individual-familiar",
      "permanent": true
    },
    {
      "source": "/os-beneficios-de-um-convenio-medico-particular{/}?",
      "destination": "/plano-de-saude-sem-cnpj",
      "permanent": true
    },
    {
      "source": "/plano-de-saude-distrito-federal",
      "destination": "/plano-de-saude-brasilia",
      "permanent": true
    },
    {
      "source": "/plano-de-saude-parana",
      "destination": "/plano-de-saude-curitiba-parana",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
